# ======================
# Node.js / Sequelize / MySQL .gitignore
# ======================

# Dependencias
node_modules/
package-lock.json
yarn.lock

# Archivos de entorno 
.env

# Archivos de logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales
*.tmp
*.swp

# Carpetas de builds o distribuciones
dist/
build/

# Archivos de base de datos locales 
*.sqlite
*.db
*.bak

# Sequelize CLI 
migrations/*.js~
seeders/*.js~
models/*.js~

# Archivos del editor 
.vscode/
.idea/

# Cobertura de tests
coverage/
